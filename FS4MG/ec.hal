# Load EtherCAT configuration from XML
loadusr -W lcec_conf ethercat-conf.xml

# Load EtherCAT
loadrt lcec

# Add EtherCAT to the servo thread
addf	lcec.read-all			servo-thread
addf	lcec.write-all			servo-thread

net 1008_IN_0 lcec.0.D2.din-0
net 1008_IN_1 lcec.0.D2.din-1
net 1008_IN_2 lcec.0.D2.din-2
net 1008_IN_3 lcec.0.D2.din-3
net 1008_IN_4 lcec.0.D2.din-4
net 1008_IN_5 lcec.0.D2.din-5 #DEFEKT
net 1008_IN_6 lcec.0.D2.din-6
net 1008_IN_7 lcec.0.D2.din-7

net 2008_OUT_0 lcec.0.D3.dout-0
net 2008_OUT_1 lcec.0.D3.dout-1
net 2008_OUT_2 lcec.0.D3.dout-2
net 2008_OUT_3 lcec.0.D3.dout-3
net 2008_OUT_4 lcec.0.D3.dout-4
net 2008_OUT_5 lcec.0.D3.dout-5
net 2008_OUT_6 lcec.0.D3.dout-6
net 2008_OUT_7 lcec.0.D3.dout-7

net DI-ATC-drawbar-sensor motion.digital-in-00 <= lcec.0.D4.din-0    #tool released
net DI-ATC-tool-sensor motion.digital-in-01 <= lcec.0.D4.din-1        #tool clamped
net 1088_IN_2 lcec.0.D4.din-2
net 1088_IN_3 lcec.0.D4.din-3
net 1088_IN_4 lcec.0.D4.din-4
net 1088_IN_5 lcec.0.D4.din-5
net 1088_IN_6 lcec.0.D4.din-6
net 1088_IN_7 lcec.0.D4.din-7

net machine-is-enabled lcec.0.D5.dout-0      #enable drives
net machine-is-enabled lcec.0.D5.dout-1
net machine-is-enabled lcec.0.D5.dout-2
net 2088_OUT_3 lcec.0.D5.dout-3
net 2088_OUT_4 lcec.0.D5.dout-4
net 2088_OUT_5 lcec.0.D5.dout-5
net 2088_OUT_6 lcec.0.D5.dout-6
net 2088_OUT_7 lcec.0.D5.dout-7
